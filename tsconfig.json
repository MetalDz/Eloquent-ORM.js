{
  "compilerOptions": {
    "target": "ES2017",           // or at least ES2015
    "lib": ["ES2020", "DOM"],     // enables modern collections like Map, Set
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "downlevelIteration": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/test/testConnection.ts"]
}
