{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/app/**/*",
    "src/test/**/*",
    "src/lab_test/**/*",
    "src/**/*.test.ts",
    "src/pivot.factory.test.ts"
  ]
}
